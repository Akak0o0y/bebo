{
  "name": "bebo",
  "version": "1.1.1",
  "description": "Bebo, your playful Windows desktop AI companion",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "prepare:phone": "node scripts/prepare-phone.cjs",
    "predesktop": "npm run prepare:phone && npm run prepare:voice",
    "predesktop:dev": "npm run prepare:phone && npm run prepare:voice",
    "prepackage:win": "npm run prepare:phone && npm run prepare:voice",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "package:win": "npm run build && electron-builder --win portable --publish never",
    "prepare:voice": "node scripts/prepare-voice.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "app.bebo.desktop",
    "productName": "Bebo",
    "directories": {
      "output": "release/constellation"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/onnxruntime-node/bin/napi-v3/linux/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/darwin/**/*",
      "!node_modules/onnxruntime-node/bin/napi-v3/win32/arm64/**/*"
    ],
    "win": {
      "artifactName": "Bebo-Portable.exe",
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "electronDist": "node_modules/electron/dist",
    "portable": {
      "unpackDirName": true
    },
    "extraResources": [
      {
        "to": "terminal.ps1",
        "from": "electron/terminal.ps1"
      },
      {
        "to": "windows.ps1",
        "from": "electron/windows.ps1"
      },
      {
        "to": "cloudflared.exe",
        "from": "build/cloudflared.exe"
      },
      {
        "from": "build/voice",
        "to": "voice"
      }
    ],
    "compression": "store",
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/phonemizer/**"
    ]
  },
  "overrides": {
    "shell-quote": "^1.12.0",
    "global-agent": "^4.1.3",
    "sharp": "^0.35.5"
  }
}
